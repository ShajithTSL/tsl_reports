  },
  {
   "fieldname": "footer_line_2",
   "fieldtype": "Small Text",
   "label": "Footer Line 2",
   "default": "\u0627\u0644\u0627\u0645\u0627\u0631\u0627\u062a \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0645\u062a\u062d\u062f\u0629 - \u062f\u0628\u064a - \u0627\u0644\u0642\u0635\u064a\u0635 \u0627\u0644\u0635\u0646\u0627\u0639\u064a\u0629 4 \u2013 \u0634\u0627\u0631\u0639 \u062f\u0645\u0634\u0642 - \u0645\u0633\u062a\u0648\u062f\u0639: \u0633 03 \u2013 \u062a\u0644\u0641\u0648\u0646: \u200e+971 4 287 0082\u200e \u2013 \u0625\u064a\u0645\u064a\u0644: INFO-UAE@TSL-ME.COM",
   "description": "Arabic text is printed right-to-left"
  },
  {
   "fieldname": "show_page_numbers",
   "fieldtype": "Check",
   "label": "Show Report No. and Page X of Y",
   "default": "1"
  },
  {
   "fieldname": "signoff_position",
   "fieldtype": "Select",
   "label": "Sign-Off Position",
   "options": "Bottom of last page\nAfter content",
   "default": "Bottom of last page",
   "description": "Bottom of last page: signatures sit just above the footer on the last page. After content: right after the last block."
  },
  {
   "fieldname": "footer_email",
   "fieldtype": "Data",
   "label": "Footer Email",
   "default": "INFO-UAE@TSL-ME.COM",
   "description": "Printed in the middle of the footer on every page. Empty = INFO-UAE@TSL-ME.COM; type - (a dash) to hide it."
  },
  {
   "fieldname": "sb_colors",
   "fieldtype": "Section Break",
   "label": "Colours",

 "fields": [
  {
   "fieldname": "format_name",
   "fieldtype": "Data",
   "label": "Format Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "is_default",
   "fieldtype": "Check",
   "label": "Default",
   "in_list_view": 1,
   "description": "Used when a report has no header format selected"
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Use Automatically for Customer",
   "options": "Customer",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "disabled",
   "fieldtype": "Check",
   "label": "Disabled"
  },
  {
   "fieldname": "sb_layout",
   "fieldtype": "Section Break",
   "label": "Header"
  },
  {
   "fieldname": "layout",
   "fieldtype": "Select",
   "label": "Layout",
   "options": "Our Logo + Company Name\nOur Logo + Customer Logo\nCustomer Logo + Our Logo\nCompany Name Only",
   "default": "Our Logo + Company Name"
  },
  {
   "fieldname": "our_logo",
   "fieldtype": "Attach Image",
   "label": "Our Logo",
   "default": "/assets/tsl_reports/images/tsl_logo.png"
  },
  {
   "fieldname": "logo_height",
   "fieldtype": "Int",
   "label": "Logo Height (mm)",
   "default": "15"
  },
  {
   "fieldname": "cb_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "company_name",
   "fieldtype": "Data",
   "label": "Company Name",
   "default": "TSL ELECTRONICS SERVICES LLC"
  },
  {
   "fieldname": "company_name_ar",
   "fieldtype": "Data",
   "label": "Company Name (Arabic)",
   "default": "\u062a\u064a \u0627\u0633 \u0627\u0644 \u0644\u0625\u0635\u0644\u0627\u062d \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0627\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0634.\u0630.\u0645.\u0645"
  },
  {
   "fieldname": "tagline",
   "fieldtype": "Data",
   "label": "Extra Line Under Name",
   "description": "Optional, e.g. Branch name, licence no. or 'Approved Contractor of \u2026'"
  },
  {
   "fieldname": "company_name_size",
   "fieldtype": "Float",
   "label": "Company Name Size (pt)",
   "default": "12",
   "description": "Make it smaller if the name wraps onto two lines (e.g. 10 or 11)."
  },
  {
   "fieldname": "company_name_ar_size",
   "fieldtype": "Float",
   "label": "Arabic Name Size (pt)",
   "default": "10"
  },
  {
   "fieldname": "name_image",
   "fieldtype": "Attach Image",
   "label": "Company Name as Image",
   "description": "Optional. Upload an image of the company name (e.g. English + Arabic together). When set, it is printed instead of the typed names above."
  },
  {
   "fieldname": "name_image_height",
   "fieldtype": "Float",
   "label": "Name Image Height (mm)",
   "default": "14",
   "depends_on": "eval:doc.name_image"
  },
  {
   "fieldname": "sb_customer",
   "fieldtype": "Section Break",
   "label": "Customer in Header"
  },
  {
   "fieldname": "customer_logo",
   "fieldtype": "Attach Image",
   "label": "Customer Logo",
   "description": "Leave empty to use the image from the report's Customer record"
  },
  {
   "fieldname": "cb_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "show_customer_name",
   "fieldtype": "Check",
   "label": "Show Customer Name in Header"
  },
  {
   "fieldname": "customer_label",
   "fieldtype": "Data",
   "label": "Customer Label",
   "default": "Prepared for",
   "depends_on": "eval:doc.show_customer_name"
  },
  {
   "fieldname": "sb_refs",
   "fieldtype": "Section Break",
   "label": "References (printed on every page)"
  },
  {
   "fieldname": "references",
   "fieldtype": "Table",
   "label": "References",
   "options": "Technical Report Header Field",
   "description": "e.g. Contract No., PO No., Call-off No. The values here are defaults \u2013 each report can change them. Empty ones are not printed."
  },
  {
   "fieldname": "references_align",
   "fieldtype": "Select",
   "label": "References Alignment",
   "options": "Left\nCenter\nRight",
   "default": "Left",
   "description": "Where the reference strip (Contract No., PO No. \u2026) sits under the logos."
  },
  {
   "fieldname": "sb_footer",
   "fieldtype": "Section Break",
   "label": "Footer",

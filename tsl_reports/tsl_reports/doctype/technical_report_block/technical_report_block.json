 "fields": [
  {
   "fieldname": "block_type",
   "fieldtype": "Select",
   "label": "Block Type",
   "options": "Heading\nSub Heading\nText\nInfo Table\nKey-Value\nTable Row\nChecklist Row\nOptions Row\nTest Row\nImage\nPage Break",
   "reqd": 1,
   "in_list_view": 1,
   "columns": 2,
   "default": "Text"
  },
  {
   "fieldname": "title",
   "fieldtype": "Small Text",
   "label": "Title / Step / Test / Key / Caption",
   "in_list_view": 1,
   "columns": 3,
   "depends_on": "eval:![\"Page Break\",\"Text\",\"Info Table\"].includes(doc.block_type)",
   "description": "Heading text, checklist step, test name, key, or image caption"
  },
  {
   "fieldname": "content",
   "fieldtype": "Text Editor",
   "label": "Content",
   "depends_on": "eval:doc.block_type==\"Text\"",
   "description": "Paragraphs and bullet lists. Use the editor's list buttons for bullets."
  },
  {
   "fieldname": "expected",
   "fieldtype": "Data",
   "label": "Expected Result / Column 3",
   "depends_on": "eval:[\"Test Row\",\"Table Row\"].includes(doc.block_type)"
  },
  {
   "fieldname": "col4",
   "fieldtype": "Data",
   "label": "Column 4",
   "depends_on": "eval:doc.block_type==\"Table Row\""
  },
  {
   "fieldname": "value",
   "fieldtype": "Small Text",
   "label": "Value / Notes / Reading / Column 2",
   "in_list_view": 1,
   "columns": 3,
   "depends_on": "eval:[\"Key-Value\",\"Table Row\",\"Checklist Row\",\"Test Row\",\"Options Row\"].includes(doc.block_type)"
  },
  {
   "fieldname": "choices",
   "fieldtype": "Small Text",
   "label": "Options",
   "depends_on": "eval:doc.block_type==\"Options Row\"",
   "description": "Options Row: the tick boxes to print, comma separated, e.g. Clean, Corroded, Dirty, Dust. The ticked ones are stored in Value."
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "\nDone\nN/A\nPass\nFail",
   "in_list_view": 1,
   "columns": 1,
   "depends_on": "eval:[\"Checklist Row\",\"Test Row\"].includes(doc.block_type)"
  },
  {
   "fieldname": "image",
   "fieldtype": "Attach Image",
   "label": "Image",
   "depends_on": "eval:doc.block_type==\"Image\""
  },
  {
   "fieldname": "image_from",
   "fieldtype": "Data",
   "label": "Take Photo From",
   "depends_on": "eval:doc.block_type==\"Image\"",
   "description": "Optional. Field holding the photo, filled in when the template loads (if the block has no photo yet): e.g. image (report field), items.image (child table), job.image (linked job document). You can still replace the photo afterwards."
  },
  {
   "fieldname": "columns",
   "fieldtype": "Select",
   "label": "Images per Row",
   "options": "\n1\n2\n3",
   "depends_on": "eval:doc.block_type==\"Image\"",
   "description": "Read from the first image of a group of consecutive images (default 2)"
  },
  {
   "fieldname": "image_height",
   "fieldtype": "Select",
   "label": "Image Size",
   "options": "\nSmall\nMedium\nLarge",
   "depends_on": "eval:doc.block_type==\"Image\""
  },
  {
   "fieldname": "col_labels",
   "fieldtype": "Data",
   "label": "Column Headers",
   "depends_on": "eval:[\"Key-Value\",\"Table Row\",\"Checklist Row\",\"Test Row\",\"Options Row\"].includes(doc.block_type)",
   "description": "Optional, comma separated. Set on the FIRST row of a table. For Table Row, the number of headers (2\u20134) sets the number of columns, e.g. Description, Model, Calibration Date"
  },
  {
   "fieldname": "no_number",
   "fieldtype": "Check",
   "label": "Don't Number",
   "depends_on": "eval:[\"Heading\",\"Sub Heading\"].includes(doc.block_type)"
  }
 ],
